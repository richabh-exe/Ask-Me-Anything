# Clerk (dashboard → API keys). The publishable key is public; the secret key is not.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-in

# Neon. `neon env pull` writes both: pooled for the app, direct for migrations.
DATABASE_URL=postgresql://...-pooler.../neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://.../neondb?sslmode=require

# Optional. Salts the hash used to rate-limit askers. Falls back to CLERK_SECRET_KEY.
ASKER_HASH_SALT=
# The public origin for links, story cards, canonicals and the sitemap. Today https://poocho.vercel.app;
# set it to https://poocho.app once the domain is bought and production then 308-redirects *.vercel.app there.
NEXT_PUBLIC_SITE_URL=

# Optional. Clerk user IDs (comma-separated) that can open /admin, the weekly numbers page.
ADMIN_USER_IDS=
# Optional. Product analytics (PostHog). Leave empty to turn PostHog off entirely.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
